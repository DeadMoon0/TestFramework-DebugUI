<Window x:Class="TestFramework.DebugUI.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Test Framework Debugger" Height="200" Width="200"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <!--
        Two hundred square, the mark in the middle, one line of status underneath. It exists for the
        few seconds between asking for the tool and getting it, so it says what is happening and
        nothing else — there is no room for anything else, and nothing else is wanted while waiting.
    -->
    <Border CornerRadius="6" Background="#FF1A1A1A" BorderBrush="#FF2C2C2C" BorderThickness="1">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- The application's own icon, so the launcher is recognisably the thing it starts. -->
            <Image Source="Icon.ico" Width="72" Height="72" VerticalAlignment="Center" HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

            <!--
                Wrapped, not trimmed. Two hundred pixels is narrower than most of what this has to
                say, and a status ending in an ellipsis withholds the half that explains itself.
            -->
            <TextBlock x:Name="tbStatus" Grid.Row="1" Margin="0 10 0 0"
                       Foreground="#FF9A9A9A" FontSize="11" TextAlignment="Center"
                       TextWrapping="Wrap"
                       Text="Starting…"/>

            <!--
                Indeterminate until a download reports a size, because a bar that fills instantly and
                then waits reads as a hang.
            -->
            <ProgressBar x:Name="pbProgress" Grid.Row="2" Height="3" Margin="0 10 0 0"
                         Background="#FF232323" Foreground="#FF62A8C9" BorderThickness="0"
                         IsIndeterminate="True"/>
        </Grid>
    </Border>
</Window>
