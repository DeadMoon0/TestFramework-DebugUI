<UserControl x:Class="TestFramework.DebugUI.Controls.Board.UC_Board"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" ClipToBounds="True">
    <Border Background="Transparent">
        <!--
            Nothing but the canvas. The run's name and the six things you can do to it used to sit on a
            plate across the top of this control; they are in the title bar now, which had the room to
            spare and does not have a run drawn underneath it.
        -->
        <Grid>
            <!--
                The button events are the tunnelling ones. A card handles its own click to select itself,
                and a bubbling handler here never ran once it did — which left the surface believing a
                button was still down, so the board went on panning with nothing held. Tunnelling reaches
                the surface before any card can mark the event handled, so the pan can always be ended.
            -->
            <Border x:Name="bSurface" Background="Transparent" Margin="0"
                    ClipToBounds="True" MouseWheel="Surface_MouseWheel"
                    PreviewMouseLeftButtonDown="Surface_MouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="Surface_MouseLeftButtonUp"
                    LostMouseCapture="Surface_LostMouseCapture"
                    MouseMove="Surface_MouseMove">
                <!--
                    Two layers over one surface: the run, and whatever somebody drew on it. A grid rather than
                    nesting them, because a redraw of the board must not be able to take a drawing with it.
                -->
                <Grid>
                    <Canvas x:Name="cBoard" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="stZoom" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="ttPan" X="0" Y="0"/>
                            </TransformGroup>
                        </Canvas.RenderTransform>
                    </Canvas>

                    <!--
                        Carries the board's own transform - set in code to the very same object - so panning and
                        zooming move the marks with the run. No background, so the board underneath stays
                        clickable everywhere a mark is not.
                    -->
                    <Canvas x:Name="cAnnotations" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="5"/>
                </Grid>
            </Border>

            <TextBlock x:Name="tbEmpty" Style="{StaticResource MutedText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="Pick a run on the left."/>
        </Grid>
    </Border>
</UserControl>
