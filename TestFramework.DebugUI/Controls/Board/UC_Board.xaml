<UserControl x:Class="TestFramework.DebugUI.Controls.Board.UC_Board"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" ClipToBounds="True">
    <Border Background="Transparent">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--
                What acts on the run being watched, and nothing else. Where you go in the
                application is navigation and lives in the title bar; what you do to this run lives
                here, over the board it changes. Collected into one plate so the group reads as
                belonging to the run under it rather than as loose controls on the canvas.
            -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0 8 0 0"
                    CornerRadius="2.5" Background="{StaticResource SurfacePanel}" Padding="8 5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="tbRunName" Style="{StaticResource PanelHeading}"
                               VerticalAlignment="Center" Margin="2 0 12 0" Text="NO RUN SELECTED"/>

                    <Button x:Name="btContinue" Style="{StaticResource PrimaryButton}" Margin="0 0 4 0" Padding="7 2"
                            Content="Continue" Click="btContinue_Click" Visibility="Collapsed"
                            ToolTip="Release the step waiting at its breakpoint."/>
                    <Button x:Name="btStop" Style="{StaticResource FlatButton}" Margin="0 0 4 0" Padding="7 2"
                            Content="Stop" Click="btStop_Click"
                            ToolTip="Ask the run to stop. It unwinds through its cleanup stage; nothing is killed."/>
                    <Button x:Name="btRerun" Style="{StaticResource FlatButton}" Margin="0 0 4 0" Padding="7 2"
                            Content="Re-run" Click="btRerun_Click"
                            ToolTip="Run this test again. The new run appears here on its own."/>
                    <Button x:Name="btFirstFailure" Style="{StaticResource FlatButton}" Margin="0 0 4 0" Padding="7 2"
                            Content="First failure" Click="btFirstFailure_Click"
                            ToolTip="Select the first step that failed."/>
                    <Button x:Name="btSummary" Style="{StaticResource FlatButton}" Margin="0 0 4 0" Padding="7 2"
                            Content="Summary" Click="btSummary_Click"
                            ToolTip="Whether this run can be trusted, and what failed if not."/>
                    <Button x:Name="btFit" Style="{StaticResource FlatButton}" Padding="7 2"
                            Content="Fit" Click="btFit_Click" ToolTip="Scale the board so all of it is on screen."/>
                </StackPanel>
            </Border>

            <Border x:Name="bSurface" Grid.Row="1" Background="Transparent" Margin="0"
                    ClipToBounds="True" MouseWheel="Surface_MouseWheel"
                    MouseLeftButtonDown="Surface_MouseLeftButtonDown" MouseLeftButtonUp="Surface_MouseLeftButtonUp"
                    MouseMove="Surface_MouseMove">
                <Canvas x:Name="cBoard" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="stZoom" ScaleX="1" ScaleY="1"/>
                            <TranslateTransform x:Name="ttPan" X="0" Y="0"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>
                </Canvas>
            </Border>

            <TextBlock x:Name="tbEmpty" Grid.Row="1" Style="{StaticResource MutedText}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Text="Pick a run on the left."/>
        </Grid>
    </Border>
</UserControl>
