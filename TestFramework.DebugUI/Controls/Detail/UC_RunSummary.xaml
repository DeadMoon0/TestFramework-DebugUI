<UserControl x:Class="TestFramework.DebugUI.Controls.Detail.UC_RunSummary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <!--
        The answer to "can I trust this run", before anyone starts hunting through steps. It leads
        with the verdict, then the counts behind it, then the failures themselves — so the reader
        either stops at the first line or has somewhere to click.
    -->
    <Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

            </Grid>

            <StackPanel Grid.Row="1" Margin="12 4 12 0">
                <Border x:Name="bVerdict" CornerRadius="4" Padding="12 10" Background="#2862C98F">
                    <StackPanel>
                        <TextBlock x:Name="tbVerdict" Style="{StaticResource BodyText}" FontSize="16" FontWeight="Bold"/>
                        <TextBlock x:Name="tbVerdictWhy" Style="{StaticResource MutedText}" Margin="0 3 0 0"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="tbCounts" Style="{StaticResource MutedText}" Margin="0 12 0 0"/>
            </StackPanel>

            <ScrollViewer Grid.Row="2" Margin="12 10 12 12" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock x:Name="tbFailuresLabel" Style="{StaticResource PanelHeading}" Margin="0 0 0 4"
                               Text="WHAT FAILED" Visibility="Collapsed"/>
                    <StackPanel x:Name="spFailures"/>

                    <!-- The checks themselves. Until protocol 4 an assertion was a count on this page and a
                         sentence on the wire; now it is a check with its arguments, which is what a reader
                         needs to see: what was expected of what, and what was there instead. -->
                    <TextBlock x:Name="tbChecksLabel" Style="{StaticResource PanelHeading}" Margin="0 12 0 4"
                               Text="CHECKS THAT DID NOT HOLD" Visibility="Collapsed"/>
                    <StackPanel x:Name="spChecks"/>

                    <!--
                        Where the run's time went, against the last run of this test that passed. Below the
                        failures because a broken run is read for what broke; for a run that passed and took
                        four times as long, this is the only section with anything to say.
                    -->
                    <TextBlock x:Name="tbTimingLabel" Style="{StaticResource PanelHeading}" Margin="0 12 0 4"
                               Text="WHERE THE TIME WENT" Visibility="Collapsed"/>
                    <TextBlock x:Name="tbTimingHeadline" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                               Margin="0 0 0 6" Visibility="Collapsed"/>
                    <StackPanel x:Name="spTiming"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
