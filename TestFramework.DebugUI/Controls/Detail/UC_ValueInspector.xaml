<UserControl x:Class="TestFramework.DebugUI.Controls.Detail.UC_ValueInspector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <!--
        Everything the rail had no room for. The rail answers "what is this" in one line; this answers
        "what is actually in it" — the facts laid out, and as much of the content as was sent, with
        the file for the rest.
    -->
    <Border Style="{StaticResource PanelOverlay}" Width="640">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Viewbox Width="14" Height="14" Margin="12 0 0 0" VerticalAlignment="Center">
                    <Canvas Width="16" Height="16">
                        <Path x:Name="pIcon" StrokeThickness="1.2" Stroke="#FF7A7A7A"/>
                    </Canvas>
                </Viewbox>

                <TextBlock x:Name="tbKey" Grid.Column="1" Style="{StaticResource PanelHeading}" Margin="8 5 0 5"
                           TextTrimming="CharacterEllipsis"/>

                <Button x:Name="btClose" Grid.Column="2" Style="{StaticResource FlatButton}" Margin="0 5 8 5"
                        Padding="7 2" Content="Close" Click="btClose_Click"/>
            </Grid>

            <StackPanel Grid.Row="1" Margin="12 4 12 0">
                <TextBlock x:Name="tbSummary" Style="{StaticResource BodyText}" TextWrapping="Wrap"/>

                <!-- The facts, one per row. This is the room the rail promised them. -->
                <Grid x:Name="gFacts" Margin="0 10 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                </Grid>

                <!-- An artifact's history, which a variable has none of and shows nothing for. -->
                <WrapPanel x:Name="wpVersions" Margin="0 8 0 0"/>
            </StackPanel>

            <Border Grid.Row="2" Margin="12 12 12 0" CornerRadius="2.5"
                    Background="{StaticResource SurfaceSunken}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="tbPreviewLabel" Style="{StaticResource PanelHeading}" Margin="10 6 10 2"/>

                    <ScrollViewer Grid.Row="1" Margin="10 0 4 8" MaxHeight="360"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <!--
                            A TextBox rather than a TextBlock, so the content can be selected and
                            copied. Someone who has found the value they were hunting for usually
                            wants to take it somewhere. CodeText targets TextBlock, so the same
                            settings are spelled out here.
                        -->
                        <TextBox x:Name="tbPreview" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" Padding="0"
                                 Foreground="{StaticResource TextSecondary}"
                                 FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="11"
                                 TextWrapping="NoWrap"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--
                Present exactly when the preview was cut. A reader who can see the value was truncated
                and cannot reach the rest is worse off than one who was never shown it.
            -->
            <Grid x:Name="gBody" Grid.Row="3" Margin="12 10 12 12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="tbBody" Style="{StaticResource MutedText}" FontSize="10"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                <Button x:Name="btOpen" Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="8 0 0 0"
                        Padding="10 3" Content="Open file" Click="btOpen_Click"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
