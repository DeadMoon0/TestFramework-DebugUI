<UserControl x:Class="TestFramework.DebugUI.Controls.Detail.UC_ValueItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <Border x:Name="bdRoot" CornerRadius="2.5" Background="{StaticResource SurfaceRaised}" Margin="0 0 0 4"
            Cursor="Hand" MouseLeftButtonUp="bdRoot_MouseLeftButtonUp"
            MouseEnter="bdRoot_MouseEnter" MouseLeave="bdRoot_MouseLeave">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--
                A coloured edge in the same two colours the board draws pipes in, so a value in this
                rail and the same value flowing between steps read as one thing.
            -->
            <Border x:Name="bdEdge" Width="3" CornerRadius="2.5 0 0 2.5" Background="{StaticResource FlowVariable}"/>

            <Grid Grid.Column="1" Margin="8 6 8 6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Viewbox Width="14" Height="14" Margin="0 1 8 0" VerticalAlignment="Top" Grid.RowSpan="2">
                    <Canvas Width="16" Height="16">
                        <Path x:Name="pIcon" StrokeThickness="1.2" Stroke="#FF7A7A7A"/>
                    </Canvas>
                </Viewbox>

                <!--
                    The key, with room in front of it for how it stands against the last run that
                    passed. A Grid rather than a horizontal StackPanel so the key keeps its ellipsis:
                    stacked, it would size to its content and run under the badges instead of
                    trimming.
                -->
                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="bdChange" Visibility="Collapsed" CornerRadius="2" Margin="0 0 5 0"
                            Padding="3 0 3 0" VerticalAlignment="Center">
                        <TextBlock x:Name="tbChange" FontSize="10" FontWeight="SemiBold"/>
                    </Border>

                    <TextBlock x:Name="tbKey" Grid.Column="1" Style="{StaticResource BodyText}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </Grid>

                <!-- Lifecycle and the like, stated by the producer rather than inferred here. -->
                <StackPanel x:Name="spBadges" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"/>

                <TextBlock x:Name="tbSummary" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                           Style="{StaticResource MutedText}" FontSize="10"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>

                <!-- The named facts, which the old single line had to throw away to fit. -->
                <TextBlock x:Name="tbFacts" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0 3 0 0"
                           Foreground="{StaticResource TextFaint}" FontSize="9"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>

                <!--
                    The journey, one chip per captured version. This is the surface the artifact
                    version work in Core was for: before it, only the first version ever reached a
                    consumer.
                -->
                <WrapPanel x:Name="wpVersions" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Margin="0 4 0 0"/>

                <!--
                    Where the rest of it went. Present exactly when the value was too big to send, so
                    a cut value is never a dead end.
                -->
                <TextBlock x:Name="tbBody" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="0 4 0 0"
                           FontSize="9" Cursor="Hand" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                           Foreground="{StaticResource TextSecondary}"
                           MouseLeftButtonUp="tbBody_MouseLeftButtonUp"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
