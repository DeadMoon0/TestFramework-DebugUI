<UserControl x:Class="TestFramework.DebugUI.Controls.Detail.UC_Widget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <!--
        One thing a step showed, in a frame of its own. The frame is what makes a widget a widget
        rather than a picture on a panel: it says who produced this, gives it the two or three things
        you can do with it, and leaves the middle entirely to whatever the step wanted to draw.
    -->
    <Border x:Name="bFrame" CornerRadius="6" BorderThickness="1"
            Background="{StaticResource SurfaceCard}"
            BorderBrush="{StaticResource SurfaceDivider}"
            Margin="0 0 10 10" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!--
                The head, and the tools before the name. A widget is acted on far more often than it is
                read out loud — opened, copied, blown up — so the actions sit where the eye lands and
                the name follows them.
            -->
            <StackPanel Grid.Row="0" Margin="10 8 10 6">
                <StackPanel Orientation="Horizontal" Margin="0 0 0 4">
                    <Button x:Name="btOpen" Style="{StaticResource IconButton}" Width="20" Height="20"
                            ToolTip="Open this outside the tool" Click="btOpen_Click">
                        <Path Data="{StaticResource IconFolder}" Fill="{StaticResource TextSecondary}"
                              Width="11" Height="11" Stretch="Uniform"/>
                    </Button>

                    <Button x:Name="btCopy" Style="{StaticResource IconButton}" Width="20" Height="20"
                            Margin="4 0 0 0" ToolTip="Copy where it was written" Click="btCopy_Click">
                        <Path Data="{StaticResource IconCopy}" Fill="{StaticResource TextSecondary}"
                              Width="11" Height="11" Stretch="Uniform"/>
                    </Button>
                </StackPanel>

                <TextBlock x:Name="tbTitle" Style="{StaticResource BodyText}" FontSize="12"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="tbSummary" Style="{StaticResource MutedText}" FontSize="10.5"
                           TextTrimming="CharacterEllipsis" Margin="0 1 0 0"/>
            </StackPanel>

            <!--
                The middle is the widget's own. Nothing here knows what a step wanted to draw; it hands
                over a box of a known size and gets a visual back.
            -->
            <Border x:Name="bContent" Grid.Row="1" Margin="10 0 10 0" CornerRadius="4"
                    ClipToBounds="True" Background="{StaticResource SurfaceSunken}"
                    MinHeight="150" MouseLeftButtonUp="bContent_MouseLeftButtonUp"
                    Cursor="Hand"/>

            <!--
                The foot says what kind of thing this is and how big it was, because those are the two
                questions a reader has before deciding to open it.
            -->
            <Grid Grid.Row="2" Margin="10 6 10 8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btExpand" Style="{StaticResource IconButton}" Width="20" Height="20"
                        ToolTip="Show this on its own" Click="btExpand_Click">
                    <Path Data="{StaticResource IconFit}" Fill="{StaticResource TextSecondary}"
                          Width="11" Height="11" Stretch="Uniform"/>
                </Button>

                <TextBlock x:Name="tbFoot" Grid.Column="1" Style="{StaticResource MutedText}"
                           FontSize="10" VerticalAlignment="Center" Margin="8 0 0 0"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Grid>
    </Border>
</UserControl>
