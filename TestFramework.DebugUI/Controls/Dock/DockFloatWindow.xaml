<Window x:Class="TestFramework.DebugUI.Controls.Dock.DockFloatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Test Framework Debugger" WindowStyle="None" ShowInTaskbar="False"
        Background="{StaticResource SurfaceOverlay}" MinWidth="320" MinHeight="240"
        Width="480" Height="560">
    <!--
        A panel in a window of its own. Styled here rather than left to the system, because a native tool-window
        caption beside this application's own chrome reads as a different program's window.

        The tab strip is the caption: it is where the window is dragged from, which is also where a panel is
        dragged from — so a float can be moved as a window or emptied a tab at a time, and the two gestures sit
        where a reader already expects each of them.
    -->
    <shell:WindowChrome.WindowChrome>
        <!--
            No GlassFrameThickness override. Setting it to zero takes the DWM frame away, and the frame is what
            Windows rounds and casts a shadow from — so the corner preference asked for in code had nothing left
            to round. Left at its default, the window is framed and rounded the way the main one is.
        -->
        <shell:WindowChrome CaptionHeight="30" ResizeBorderThickness="6"/>
    </shell:WindowChrome.WindowChrome>

    <!--
        No border of its own. Windows draws the frame and rounds the corners — asked for once the handle exists —
        so a border painted in here would be a second frame inside the real one, square where the real one is
        round. The panel's card chrome is gone for the same reason: in a window, the window is the card.
    -->
    <Border>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--
                No close button of its own. The caption is the panel's own header, which already has one, and a
                window holding one panel had ended up with three ways to shut the same thing. Closing the last
                panel empties the float, and an emptied float is removed by the arrangement itself.
            -->
            <Border x:Name="bStrip" Height="30" Background="{StaticResource SurfaceRaised}"/>

            <Border x:Name="bBody" Grid.Row="1"/>
        </Grid>
    </Border>
</Window>
