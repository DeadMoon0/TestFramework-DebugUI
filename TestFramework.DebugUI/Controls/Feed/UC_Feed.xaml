<UserControl x:Class="TestFramework.DebugUI.Controls.Feed.UC_Feed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <!--
        A corner tab, not a strip across the window. It carries what unselected runs are doing, which
        matters when it matters and never wants a fifth of the screen for it. Closed it is a count
        and a headline; opened it grows upwards over the canvas.
    -->
    <Border Style="{StaticResource PanelOverlay}" MaxWidth="420" VerticalAlignment="Bottom">
        <StackPanel>
            <ScrollViewer x:Name="svEntries" MaxHeight="260" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="spEntries" Margin="6 6 6 0"/>
            </ScrollViewer>

            <Grid x:Name="gHeader" MouseLeftButtonUp="Header_MouseLeftButtonUp" Background="Transparent"
                  Cursor="Hand" Margin="8 6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Foreground="{StaticResource TextFaint}" FontSize="10" FontWeight="Bold"
                           VerticalAlignment="Center" Text="FEED"/>

                <Border x:Name="bUnread" Grid.Column="1" CornerRadius="7" Background="{StaticResource AccentSelection}"
                        Padding="5 0" Height="14" VerticalAlignment="Center" Margin="6 0 0 0" Visibility="Collapsed">
                    <TextBlock x:Name="tbUnread" FontSize="9" FontWeight="Bold" Foreground="White"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="tbLatest" Grid.Column="2" Style="{StaticResource MutedText}" FontSize="10"
                           VerticalAlignment="Center" Margin="8 0 0 0" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
