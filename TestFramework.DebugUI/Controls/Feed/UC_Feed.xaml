<UserControl x:Class="TestFramework.DebugUI.Controls.Feed.UC_Feed"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <!--
        What the runs that are not on screen have to say. It used to be a tab in the bottom-right corner of the
        canvas, carrying its own count and a headline over the board; the count and the state now live on the
        bell in the title bar, and this is only the list it opens.

        Anchored under that bell rather than centred, so the panel reads as coming from the thing that was
        clicked, and narrow enough that the board is still visible beside it.
    -->
    <Border Style="{StaticResource PanelOverlay}" Width="380" Margin="0 4 10 0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource PanelHeading}" VerticalAlignment="Center" Text="NOTIFICATIONS"/>

                <TextBlock x:Name="tbCount" Grid.Column="1" Style="{StaticResource MutedText}" FontSize="10"
                           Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"/>

                <Button x:Name="btClose" Grid.Column="2" Style="{StaticResource IconButton}" Margin="0 4 8 4"
                        Click="btClose_Click" ToolTip="Close">
                    <Path Data="{StaticResource IconClose}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="None"/>
                </Button>
            </Grid>

            <!--
                Nothing yet is worth saying so, rather than opening an empty panel that looks broken.
            -->
            <TextBlock x:Name="tbEmpty" Grid.Row="1" Style="{StaticResource MutedText}" Margin="10 0 10 10"
                       Text="Nothing to report. Runs that start, finish or fail while you are looking elsewhere appear here."/>

            <ScrollViewer x:Name="svEntries" Grid.Row="1" MaxHeight="420" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="spEntries" Margin="6 0 6 6"/>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
