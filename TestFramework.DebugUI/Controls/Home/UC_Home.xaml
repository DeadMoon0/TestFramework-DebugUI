<UserControl x:Class="TestFramework.DebugUI.Controls.Home.UC_Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <!--
        Every run in one place — a panel like any other, drawn inside the card the dock host gives it.

        It used to be a page: its own scrim over the board, its own inset card, its own title and its own way
        out. All four have gone. A panel that dims what is behind it and frames itself is a panel that reads as
        a different kind of thing from the ones beside it, and this one is not — it is the widest of them, which
        is why it opens in the centre, and that is the whole of the difference.

        Triage, then browse. A journal is mostly runs that passed and runs nobody has opened, and giving
        each of those the same hundred-pixel card as a failure made the one run worth looking at
        indistinguishable from the fifty that were not. So the few that need attention get cards at the
        top, and everything else becomes a scannable list underneath.
    -->
    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.ColumnSpan="2" Margin="14 8 10 8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="tbOverview" Style="{StaticResource MutedText}" VerticalAlignment="Center"/>

                <Border x:Name="bActionSlot" Grid.Column="1">
                <StackPanel x:Name="spActions" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btShare" Style="{StaticResource IconButton}" Margin="0 0 6 0"
                            Background="{StaticResource SurfaceCard}" Click="btShare_Click"
                            ToolTip="Share the runs listed here as a file">
                        <Path Data="{StaticResource IconExport}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="None"/>
                    </Button>
                    <Button x:Name="btImport" Style="{StaticResource IconButton}" Margin="0 0 6 0"
                            Background="{StaticResource SurfaceCard}" Click="btImport_Click"
                            ToolTip="Open a run someone shared">
                        <Path Data="{StaticResource IconImport}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="None"/>
                    </Button>
                    <Button x:Name="btRefresh" Style="{StaticResource IconButton}" Margin="0 0 6 0"
                            Background="{StaticResource SurfaceCard}" Click="btRefresh_Click"
                            ToolTip="Look again on disk">
                        <Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="None"/>
                    </Button>
                </StackPanel>
                </Border>
            </Grid>

            <!--
                Project, then class, then the tests in it. The rail is the categorisation: a run belongs
                to a test, a test to a class and a class to a project, and that is how anyone looks for
                one. It narrows what is on the right rather than opening anything, so browsing costs
                nothing. Only the selected class shows its tests, which is what keeps the rail short
                enough to be read at all.
            -->
            <Border Grid.Row="1" Margin="14 0 0 14" CornerRadius="6" Background="{StaticResource SurfacePanel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="8 8 8 8">
                    <StackPanel x:Name="spTree"/>
                </ScrollViewer>
            </Border>

            <Grid Grid.Row="1" Grid.Column="1" Margin="16 0 20 20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- The few worth looking at, in full. Hidden outright when there are none, because a
                     heading over an empty box is a heading that has to be read to learn nothing. -->
                <StackPanel x:Name="spAttention" Visibility="Collapsed" Margin="0 0 0 14">
                    <TextBlock x:Name="tbAttention" Style="{StaticResource PanelHeading}" Margin="0 0 0 8"/>
                    <WrapPanel x:Name="wpAttention" Orientation="Horizontal"/>
                    <TextBlock x:Name="tbAttentionMore" Style="{StaticResource MutedText}" FontSize="10"
                               Foreground="{StaticResource TextFaint}" Visibility="Collapsed" Margin="2 2 0 0"/>
                </StackPanel>

                <!-- Outside the scroll, so the columns are still labelled at the bottom of a long list.
                     The widths are duplicated from UC_RunRow on purpose: this is the one place they have
                     to agree, and a shared style would hide that. -->
                <Grid x:Name="gColumns" Grid.Row="1" Margin="0 0 6 4" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*" MinWidth="140"/>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="62"/>
                        <ColumnDefinition Width="92"/>
                        <ColumnDefinition Width="96"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="1" Style="{StaticResource PanelHeading}" Margin="10 0 8 0" Text="TEST"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource PanelHeading}" Margin="0" Text="CLASS"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource PanelHeading}" Margin="0" Text="TIME"/>
                    <TextBlock Grid.Column="4" Style="{StaticResource PanelHeading}" Margin="0" Text="TOOK"/>
                    <TextBlock Grid.Column="5" Style="{StaticResource PanelHeading}" Margin="0" Text="STEPS"/>
                    <TextBlock Grid.Column="6" Style="{StaticResource PanelHeading}" Margin="0" Text="CHECKS"/>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="spRuns"/>
                </ScrollViewer>

                <TextBlock x:Name="tbEmpty" Grid.Row="2" Style="{StaticResource MutedText}" Margin="0 40 0 0"
                           HorizontalAlignment="Center"
                           Text="No runs yet. Start a test with the debugger attached, or record one and it will be listed here."/>
            </Grid>
    </Grid>
</UserControl>
