<UserControl x:Class="TestFramework.DebugUI.Controls.Home.UC_Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <!--
        Every run in one place. An overlay rather than a full-bleed page: inset so the board is
        visibly still there underneath, on a scrim so it is clearly the thing in front, and opaque
        because a wall of cards read through a live canvas is unreadable.
    -->
    <Grid Background="{StaticResource Scrim}">
    <Border Margin="16" CornerRadius="4" Background="{StaticResource SurfaceOverlay}"
            BorderBrush="#14FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.ColumnSpan="2" Margin="20 16 20 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" FontSize="18" FontWeight="Bold" Text="Runs"/>
                    <TextBlock x:Name="tbOverview" Style="{StaticResource MutedText}" Margin="0 2 0 0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btRefresh" Style="{StaticResource IconButton}" Margin="0 0 6 0"
                            Background="{StaticResource SurfaceCard}" Click="btRefresh_Click"
                            ToolTip="Look again on disk">
                        <Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="None"/>
                    </Button>
                    <Button x:Name="btClose" Style="{StaticResource IconButton}"
                            Background="{StaticResource SurfaceCard}" Click="btClose_Click"
                            ToolTip="Back to the board">
                        <Path Data="{StaticResource IconClose}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="None"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!--
                Project, then test, then the runs of it. The rail is the categorisation: a run belongs
                to a test and a test belongs to a project, and that is how anyone looks for one. It
                narrows what is on the right rather than opening anything, so browsing costs nothing.
            -->
            <Border Grid.Row="1" Margin="20 0 0 20" CornerRadius="4" Background="{StaticResource SurfacePanel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="8 8 8 8">
                    <StackPanel x:Name="spTree"/>
                </ScrollViewer>
            </Border>

            <ScrollViewer Grid.Row="1" Grid.Column="1" Margin="16 0 10 0" Padding="0 0 10 20"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <WrapPanel x:Name="wpRuns" Orientation="Horizontal"/>

                    <TextBlock x:Name="tbEmpty" Style="{StaticResource MutedText}" Margin="0 40 0 0"
                               HorizontalAlignment="Center"
                               Text="No runs yet. Start a test with the debugger attached, or record one and it will be listed here."/>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
    </Grid>
</UserControl>
