<UserControl x:Class="TestFramework.DebugUI.Controls.Runs.UC_RunItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Cursor="Hand">
    <Border x:Name="bRoot" CornerRadius="2.5" Background="{StaticResource SurfaceRaised}" Margin="0 0 0 4"
            MouseLeftButtonUp="Root_MouseLeftButtonUp">
        <Grid Margin="8 6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="bState" Width="6" Height="6" CornerRadius="3" VerticalAlignment="Center"
                    Margin="0 0 7 0" Background="{StaticResource StateNotRun}"/>

            <TextBlock x:Name="tbName" Grid.Column="1" Style="{StaticResource BodyText}"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="run"/>

            <!-- Badged rather than merely coloured: with several runs attached, the one waiting for
                 you has to be findable at a glance. -->
            <Border x:Name="bPaused" Grid.Column="2" CornerRadius="2" Background="{StaticResource StatePaused}"
                    Padding="4 1" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Text="PAUSED" FontSize="8" FontWeight="Bold" Foreground="White"/>
            </Border>

            <TextBlock x:Name="tbWhen" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                       Style="{StaticResource MutedText}" FontSize="10" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" Text=""/>
        </Grid>
    </Border>
</UserControl>
