<UserControl x:Class="TestFramework.DebugUI.Controls.Runs.UC_Runs"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <!--
        Which run to look at, and nothing else. The runs page answers the other half — how the whole journal
        is doing, in a table six columns wide — and that half is not something a rail this narrow can show
        without truncating every column. Its root row opens it.
    -->
    <Border Style="{StaticResource PanelOverlay}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource PanelHeading}" VerticalAlignment="Center" Text="RUNS"/>

                <!-- Only says anything while the filter is on, where "12 of 54" is the number that stops a
                     reader wondering whether the rest of their runs have gone. -->
                <TextBlock x:Name="tbCount" Grid.Column="1" Style="{StaticResource MutedText}" FontSize="10"
                           Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"/>

                <Button x:Name="btRefresh" Grid.Column="2" Style="{StaticResource IconButton}" Margin="0 4 6 4"
                        Click="btRefresh_Click" ToolTip="Look again on disk">
                    <Path Data="{StaticResource IconRefresh}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="None"/>
                </Button>
            </Grid>

            <!--
                A name, at whichever level the reader happens to be thinking of. The same pattern rules the
                run search uses, so a star works here too and nobody has to learn two kinds of typing.
            -->
            <Grid Grid.Row="1" Margin="8 0 8 6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Path Data="{StaticResource IconSearch}" Stroke="{StaticResource TextFaint}" StrokeThickness="1.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="None"
                      VerticalAlignment="Center" Margin="0 0 6 0"/>

                <Grid Grid.Column="1">
                    <TextBox x:Name="tbFilter" BorderThickness="0" Background="Transparent"
                             Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource Accent}"
                             FontSize="12" VerticalAlignment="Center" VerticalContentAlignment="Center"
                             TextChanged="tbFilter_TextChanged" PreviewKeyDown="tbFilter_PreviewKeyDown"/>

                    <TextBlock x:Name="tbFilterHint" Style="{StaticResource MutedText}" FontSize="12"
                               Foreground="{StaticResource TextFaint}" VerticalAlignment="Center"
                               IsHitTestVisible="False" Text="Filter by test, class or project"/>
                </Grid>

                <Button x:Name="btClearFilter" Grid.Column="2" Style="{StaticResource IconButton}"
                        Margin="0 -2 0 -2" Visibility="Collapsed" Click="btClearFilter_Click" ToolTip="Clear the filter">
                    <Path Data="{StaticResource IconClose}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="None"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="spTree" Margin="5 0 5 5"/>
            </ScrollViewer>

            <TextBlock x:Name="tbEmpty" Grid.Row="2" Style="{StaticResource MutedText}" Margin="14 4 14 0"
                       Text="No runs yet. Start a test and it will appear here, whether or not this window was open when it ran."/>
        </Grid>
    </Border>
</UserControl>
