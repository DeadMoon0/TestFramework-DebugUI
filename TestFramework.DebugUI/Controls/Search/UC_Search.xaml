<UserControl x:Class="TestFramework.DebugUI.Controls.Search.UC_Search"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d">
    <!--
        One search over the whole run, dropped from the top of the canvas the way a find bar does in every
        editor. Deliberately not a filter box per panel: the question is "where is the thing I am thinking of",
        and the answer can be a step, a log line, a value or a check.
    -->
    <Border Style="{StaticResource PanelOverlay}" Width="620" Margin="0 6 0 0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="10 8 8 6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Path Data="{StaticResource IconSearch}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="None"
                      VerticalAlignment="Center" Margin="0 0 8 0"/>

                <!--
                    Borderless and on the panel's own ground, so the bar reads as one thing rather than as a
                    form control dropped onto it. The caret is the accent, which is the only place in this
                    window the accent means "you are typing here".
                -->
                <TextBox x:Name="tbQuery" Grid.Column="1" BorderThickness="0" Background="Transparent"
                         Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource Accent}"
                         FontSize="13" VerticalAlignment="Center" VerticalContentAlignment="Center"
                         TextChanged="tbQuery_TextChanged" PreviewKeyDown="tbQuery_PreviewKeyDown"/>

                <TextBlock x:Name="tbCount" Grid.Column="2" Style="{StaticResource MutedText}" FontSize="11"
                           Foreground="{StaticResource TextFaint}" VerticalAlignment="Center" Margin="8 0 4 0"/>

                <Button x:Name="btClose" Grid.Column="3" Style="{StaticResource IconButton}" Margin="0 -2 0 -2"
                        Click="btClose_Click" ToolTip="Close  (Esc)">
                    <Path Data="{StaticResource IconClose}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="None"/>
                </Button>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{StaticResource SurfaceDivider}"/>

            <!--
                What can be written, shown only while nothing has been. A search language nobody is told about
                is a search language nobody uses, and once there is a query on screen the reader is past
                needing it.
            -->
            <StackPanel x:Name="spHints" Grid.Row="2" Margin="10 8 10 10"/>

            <TextBlock x:Name="tbProblem" Grid.Row="2" Style="{StaticResource MutedText}" Margin="10 8 10 10"
                       TextWrapping="Wrap" Foreground="{StaticResource StateTimeout}" Visibility="Collapsed"/>

            <TextBlock x:Name="tbNothing" Grid.Row="2" Style="{StaticResource MutedText}" Margin="10 8 10 10"
                       Visibility="Collapsed"
                       Text="Nothing in this run matches. Only the run on screen is searched."/>

            <ScrollViewer x:Name="svHits" Grid.Row="3" MaxHeight="420" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="spHits" Margin="6 0 6 6"/>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
