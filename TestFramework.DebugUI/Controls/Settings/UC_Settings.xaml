<UserControl x:Class="TestFramework.DebugUI.Controls.Settings.UC_Settings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shell="clr-namespace:TestFramework.DebugUI.Controls.Shell"
             mc:Ignorable="d">
    <!--
        Settings, and the two things a settings panel usually forgets: where the files it is talking
        about actually are, and a way to undo state the user built up by accident. Every change here
        applies immediately and is written immediately - there is no OK button, because there is
        nothing a Cancel could put back.
    -->
    <!--
        A scrim behind the panel, not just a floating card. The panel opens over whatever was on
        screen - often the Runs page, which is a dense grid of cards - and a translucent panel over
        that is genuinely hard to read. Dimming the rest also says which thing currently takes input.
    -->
    <Grid Background="{StaticResource Scrim}" MouseLeftButtonDown="Scrim_MouseLeftButtonDown">
        <Border Style="{StaticResource PanelOverlay}" Width="460" MaxHeight="640"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                MouseLeftButtonDown="Panel_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Style="{StaticResource PanelHeading}" Text="SETTINGS"/>
                <Button x:Name="btClose" Grid.Column="1" Style="{StaticResource IconButton}" Margin="0 5 8 5" Click="btClose_Click" ToolTip="Close">
                    <Path Data="{StaticResource IconClose}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="None"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="12 4 6 12" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0 0 6 0">

                    <TextBlock Style="{StaticResource PanelHeading}" Text="WATCHING" Margin="0 4 0 6"/>

                    <shell:UC_Toggle x:Name="tgWatch" Margin="0 0 0 12"
                                     Label="Watch for test runs"
                                     Note="Minimising hides the window to the notification area."/>

                    <shell:UC_Toggle x:Name="tgNotify" Margin="0 0 0 12"
                                     Label="Report finished runs"
                                     Note="Notify when a run finishes while the window is away."/>

                    <shell:UC_Toggle x:Name="tgFailuresOnly" Margin="0 0 0 12"
                                     Label="Only report runs that need looking at"
                                     Note="Failed, aborted and unproven runs only."/>

                    <Border Height="1" Background="{StaticResource SurfaceDivider}" Margin="0 6 0 12"/>

                    <TextBlock Style="{StaticResource PanelHeading}" Text="SHARED RUNS" Margin="0 0 0 6"/>

                    <shell:UC_Toggle x:Name="tgAssociate" Margin="0 0 0 4"
                                     Label="Open .tfrun files with this tool"
                                     Note="Double-clicking a shared run opens it here. Affects this user only."/>

                    <TextBlock x:Name="tbAssociateNote" Style="{StaticResource MutedText}" FontSize="10"
                               Foreground="{StaticResource TextFaint}" Margin="0 0 0 12" Visibility="Collapsed"/>

                    <Border Height="1" Background="{StaticResource SurfaceDivider}" Margin="0 6 0 12"/>

                    <TextBlock Style="{StaticResource PanelHeading}" Text="BREAKPOINTS" Margin="0 0 0 6"/>

                    <Grid Margin="0 0 0 12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0 0 12 0">
                            <TextBlock x:Name="tbBreakpoints" Style="{StaticResource BodyText}"/>
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0 2 0 0"
                                       Text="Right-click a step to set one. Kept between runs."/>
                        </StackPanel>

                        <Button x:Name="btClearBreakpoints" Grid.Column="1" VerticalAlignment="Top" Style="{StaticResource IconButton}" Click="btClearBreakpoints_Click" ToolTip="Clear all breakpoints">
                            <Path Data="{StaticResource IconTrash}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="None"/>
                        </Button>
                    </Grid>

                    <Border Height="1" Background="{StaticResource SurfaceDivider}" Margin="0 6 0 12"/>

                    <!-- Built from the command definitions, so this cannot fall out of step with what is bound. -->
                    <TextBlock Style="{StaticResource PanelHeading}" Text="SHORTCUTS" Margin="0 0 0 6"/>
                    <StackPanel x:Name="spShortcuts" Margin="0 0 0 12"/>

                    <Border Height="1" Background="{StaticResource SurfaceDivider}" Margin="0 0 0 12"/>

                    <TextBlock Style="{StaticResource PanelHeading}" Text="WHERE THINGS ARE" Margin="0 0 0 6"/>

                    <StackPanel Margin="0 0 0 10">
                        <TextBlock Style="{StaticResource MutedText}" Text="Recorded runs"/>
                        <TextBlock x:Name="tbRunsPath" Style="{StaticResource BodyText}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0 1 0 4"/>
                        <Button x:Name="btOpenRuns" HorizontalAlignment="Left" Style="{StaticResource IconButton}" Click="btOpenRuns_Click" ToolTip="Open folder">
                            <Path Data="{StaticResource IconFolder}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="None"/>
                        </Button>
                    </StackPanel>

                    <StackPanel Margin="0 0 0 4">
                        <TextBlock Style="{StaticResource MutedText}" Text="These settings"/>
                        <TextBlock x:Name="tbSettingsPath" Style="{StaticResource BodyText}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0 1 0 4"/>
                        <Button x:Name="btOpenSettings" HorizontalAlignment="Left" Style="{StaticResource IconButton}" Click="btOpenSettings_Click" ToolTip="Open folder">
                            <Path Data="{StaticResource IconFolder}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="None"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
        </Border>
    </Grid>
</UserControl>
