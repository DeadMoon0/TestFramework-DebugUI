<UserControl x:Class="TestFramework.DebugUI.Controls.Share.UC_Export"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:shell="clr-namespace:TestFramework.DebugUI.Controls.Shell"
             mc:Ignorable="d">
    <!--
        The two decisions worth asking about before a run leaves the machine, and nothing else. Where it goes
        is the save dialog's business, and what happened is reported in the feed like everything else, so this
        panel exists only for as long as it takes to answer two questions.
    -->
    <Grid Background="{StaticResource Scrim}">
        <Border Width="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                CornerRadius="4" Background="{StaticResource SurfaceOverlay}"
                BorderBrush="#14FFFFFF" BorderThickness="1">
            <StackPanel Margin="20 16 20 16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource BodyText}" FontSize="16" FontWeight="Bold" Text="Share"/>
                        <TextBlock x:Name="tbSubject" Style="{StaticResource MutedText}" Margin="0 2 0 0"/>
                    </StackPanel>

                    <Button x:Name="btClose" Grid.Column="1" Style="{StaticResource IconButton}" VerticalAlignment="Top"
                            Background="{StaticResource SurfaceCard}" Click="btClose_Click" ToolTip="Cancel">
                        <Path Data="{StaticResource IconClose}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="None"/>
                    </Button>
                </Grid>

                <shell:UC_Toggle x:Name="tgArtifacts" Margin="0 16 0 0"/>
                <shell:UC_Toggle x:Name="tgAnonymous" Margin="0 8 0 0"/>

                <!--
                    Shown only once there is something to say. An anonymous export rewrites the paths the
                    framework recorded and leaves logs, values and artifacts exactly as they were, so anywhere
                    the sender is named in those is reported here rather than quietly passed off as hidden.
                -->
                <Border x:Name="bWarning" Visibility="Collapsed" Margin="0 14 0 0" CornerRadius="4"
                        Background="{StaticResource SurfaceRaised}" Padding="10 8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource PanelHeading}" Margin="0 0 0 4"
                                   Foreground="{StaticResource StateTimeout}" Text="STILL NAMED IN THE CONTENT"/>
                        <TextBlock x:Name="tbWarning" Style="{StaticResource MutedText}" FontSize="10"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 18 0 0">
                    <Button x:Name="btCancel" Style="{StaticResource FlatButton}" Padding="12 5" Margin="0 0 8 0"
                            Content="Cancel" Click="btClose_Click"/>
                    <Button x:Name="btExport" Style="{StaticResource PrimaryButton}" Padding="12 5"
                            Click="btExport_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconExport}" Stroke="{StaticResource TextPrimary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18"
                                  Stretch="None" VerticalAlignment="Center"/>
                            <TextBlock Text="Save" Margin="6 0 0 0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
