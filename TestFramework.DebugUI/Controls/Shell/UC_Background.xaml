<UserControl x:Class="TestFramework.DebugUI.Controls.Shell.UC_Background"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             IsHitTestVisible="False">
    <!--
        Whatever the current theme paints behind everything, blurred far enough out of focus that it
        reads as depth rather than as a picture.

        Nothing is drawn here any more. It used to be twenty thousand characters of path data for one
        set of ridges in one set of greys, which is a background rather than a theme's background — the
        shapes now come from BackdropPainter, in the four colours the theme gives it.
    -->
    <Viewbox Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
        <!--
            The frame is the design size; the rectangle inside it is deliberately larger and centred, so
            the blur's soft edge falls outside the clip. Blurring a shape to its own boundary fades the
            boundary out, and a backdrop with four faded edges reads as a photograph laid on the window
            rather than as the window's own back.
        -->
        <Grid x:Name="gFrame" Width="480" Height="280" ClipToBounds="True">
            <Rectangle x:Name="rBackdrop" Width="576" Height="336"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <!--
                    Cached, because the blur is the only expensive thing in the window and its input
                    changes exactly as often as the theme does. Without this the effect is re-evaluated
                    whenever the window is resized, which is precisely when there is least to spare.
                -->
                <Rectangle.CacheMode>
                    <BitmapCache RenderAtScale="2"/>
                </Rectangle.CacheMode>
            </Rectangle>
        </Grid>
    </Viewbox>
</UserControl>
