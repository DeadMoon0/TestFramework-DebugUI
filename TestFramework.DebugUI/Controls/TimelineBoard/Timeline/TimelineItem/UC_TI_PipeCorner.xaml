<UserControl x:Class="TestFrameworkDebugUI.Controls.TimelineBoard.Timeline.TimelineItem.UC_TI_PipeCorner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TestFrameworkDebugUI.Controls.TimelineBoard.Timeline.TimelineItem"
             mc:Ignorable="d" 
             Height="10" Width="10">
    <Grid SnapsToDevicePixels="False" ClipToBounds="True">
        <Border Height="20" Width="20" VerticalAlignment="Bottom" CornerRadius="10">
            <Border.Background>
                <RadialGradientBrush>
                    <GradientStop Color="#00000000"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                    <GradientStop Color="#32000000" Offset="0.5"/>
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        <Border Margin="3 0 0 3" Height="14" Width="14" VerticalAlignment="Bottom" BorderBrush="#2afc4d" BorderThickness="4" CornerRadius="10"/>
    </Grid>
</UserControl>
