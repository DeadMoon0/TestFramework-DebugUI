<UserControl x:Class="TestFrameworkDebugUI.Controls.TimelineBoard.Timeline.TimelineItem.UC_TI_PipeStraightH"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TestFrameworkDebugUI.Controls.TimelineBoard.Timeline.TimelineItem"
             mc:Ignorable="d" 
             Height="10" d:DesignWidth="10">
    <Grid SnapsToDevicePixels="False">
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="3"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,0" StartPoint="0.5,1">
                    <GradientStop Color="#32000000"/>
                    <GradientStop Color="#00000000" Offset="0.75"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <Border Grid.Row="1" Background="#2afc4d"/>
        <Border Grid.Row="2">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#32000000"/>
                    <GradientStop Color="#00000000" Offset="0.75"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
    </Grid>
</UserControl>
