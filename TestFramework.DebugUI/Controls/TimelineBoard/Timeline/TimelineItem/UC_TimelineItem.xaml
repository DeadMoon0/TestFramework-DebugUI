<UserControl x:Class="TestFrameworkDebugUI.Controls.TimelineBoard.Timeline.TimelineItem.UC_TimelineItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TestFrameworkDebugUI.Controls.TimelineBoard.Timeline.TimelineItem"
             xmlns:statusIndicator="clr-namespace:TestFrameworkDebugUI.Controls.TimelineBoard.Timeline.StatusIndicator"
             mc:Ignorable="d" 
             MinHeight="200" MaxHeight="400" Width="500" Margin="10 30 10 60">
    <Border CornerRadius="2.5" Background="#FF323232">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="20"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>
            <Border CornerRadius="0 0 10 10" Background="#FF242424" Margin="5 0 5 0" Padding="5 0 5 0">
                <Canvas>
                    <StackPanel Orientation="Horizontal" Margin="0 -10 0 0">
                        <local:UC_TI_Connector IsSend="False"/>
                        <local:UC_TI_Connector IsSend="False"/>
                        <local:UC_TI_Connector IsSend="False"/>
                    </StackPanel>
                </Canvas>
            </Border>
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="gStatusHost" Width="15" Height="15" Margin="2.5">
                    <statusIndicator:UC_SI_InProgress/>
                </Grid>
                <Label x:Name="lName" Grid.Column="1" Foreground="White" FontSize="16">STEP_NAME</Label>
                <Label x:Name="lDescription" Grid.Row="1" Grid.Column="1" Foreground="White">STEP_DESCRIPTION</Label>
            </Grid>
            <Border Grid.Row="2" Background="#32000000" Margin="5" CornerRadius="2.5">
                <Grid>
                    <Label FontFamily="Consolas" Foreground="LightGray" Content="&gt; Log . .  .   .    ."/>
                </Grid>
            </Border>
            <Border Grid.Row="3" CornerRadius="10 10 0 0" Background="#FF242424" Margin="5 0 5 0" Padding="5 0 5 0">
                <Canvas>
                    <StackPanel Orientation="Horizontal" Margin="0 10 0 0">
                        <local:UC_TI_Connector IsSend="True"/>
                        <local:UC_TI_Connector IsSend="True"/>
                    </StackPanel>
                </Canvas>
            </Border>
        </Grid>
    </Border>
</UserControl>
