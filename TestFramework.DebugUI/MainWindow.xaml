<Window x:Name="window" x:Class="TestFramework.DebugUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:TestFramework.DebugUI.Controls.Shell"
        xmlns:board="clr-namespace:TestFramework.DebugUI.Controls.Board"
        xmlns:runs="clr-namespace:TestFramework.DebugUI.Controls.Runs"
        xmlns:detail="clr-namespace:TestFramework.DebugUI.Controls.Detail"
        xmlns:home="clr-namespace:TestFramework.DebugUI.Controls.Home"
        xmlns:settings="clr-namespace:TestFramework.DebugUI.Controls.Settings"
        xmlns:share="clr-namespace:TestFramework.DebugUI.Controls.Share"
        xmlns:annotate="clr-namespace:TestFramework.DebugUI.Controls.Annotate"
        xmlns:feed="clr-namespace:TestFramework.DebugUI.Controls.Feed"
        mc:Ignorable="d"
        Title="TestFrameworkDebugger" Height="800" Width="1400" WindowStyle="None" Background="#01000000"
        MinHeight="650" MinWidth="1100" AllowsTransparency="True"
        SourceInitialized="Window_SourceInitialized" StateChanged="Window_StateChanged" Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" UseAeroCaptionButtons="True"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <shell:UC_Background/>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--
                Identity, then the run and what acts on it, then the application's own controls, then the
                caption buttons. The forty pixels across the top were mostly empty while six run actions
                sat on a plate over the middle of the canvas - the one surface in the window that actually
                wants the room. They live here now.

                Everything clickable in this strip sets IsHitTestVisibleInChrome. The whole forty pixels
                is caption as far as WindowChrome is concerned, and without it the chrome swallows the
                click and drags the window instead.
            -->
            <Grid Panel.ZIndex="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Viewbox Margin="12 10" Grid.Column="0">
                    <Canvas Width="100" Height="87">
                        <Path Canvas.Left="1" Canvas.Top="0" Fill="Gray" Data="M14.77 44.826a2 2 0 0 1 .733.732l15.865 27.48a2 2 0 0 0 1.732 1h1.09a2 2 0 0 1 2 2v8.565a2 2 0 0 1-2 2h-8.345a2 2 0 0 1-1.732-1L.268 44.302a2 2 0 0 1 0-2L1.8 39.647a2 2 0 0 1 2.732-.732l10.238 5.91Zm50.089-33.26a2 2 0 0 1-1.732 1H59.19a2 2 0 0 0-2 2v57.471a2 2 0 0 0 2 2h7.09a2 2 0 0 0 1.732-1l16.59-28.735a2 2 0 0 0 0-2L69.841 16.733a2 2 0 0 1 0-2l4.946-8.566c.77-1.333 2.694-1.333 3.464 0l20.862 36.135a2 2 0 0 1 0 2l-23.845 41.3a2 2 0 0 1-1.732 1H44.191a2 2 0 0 1-2-2V14.567a2 2 0 0 0-2-2h-6.86a2 2 0 0 1-1.731-1L26.654 3c-.77-1.333.192-3 1.732-3h39.686c1.54 0 2.501 1.667 1.732 3l-4.945 8.566Z"/>
                    </Canvas>
                </Viewbox>

                <TextBlock Grid.Column="1" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                           FontWeight="Bold" FontSize="13" Text="Test Framework Debugger"/>

                <shell:UC_RunBar x:Name="ucRunBar" Grid.Column="2"/>

                <!-- Column 3 is empty on purpose: it is what is left to grab the window by. -->

                <!--
                    Watch mode is armed here rather than buried in a settings file, because it changes
                    what closing the window does and what the notification area contains - and a mode
                    that changes those without being visible is a mode that surprises people. Lit means
                    armed.
                -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8 0 0 0">
                    <Button x:Name="btHome" Style="{StaticResource CaptionIconButton}" Click="btHome_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path Data="{StaticResource IconHome}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="18" Height="18" Stretch="None"/>
                    </Button>

                    <Button x:Name="btAnnotate" Style="{StaticResource CaptionIconButton}" Click="btAnnotate_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                        <Path x:Name="pathAnnotate" Data="{StaticResource IconAnnotate}" Stroke="{StaticResource TextSecondary}"
                              StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="18" Height="18" Stretch="None"/>
                    </Button>

                    <Button x:Name="btWatch" Style="{StaticResource CaptionIconButton}"
                            Click="btWatch_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Viewbox Width="17" Height="17">
                            <Canvas Width="24" Height="24">
                                <!-- An eye: the tool is looking, whether or not anyone is looking at it. Lit
                                     means armed - the colour is the whole indicator now the label has gone. -->
                                <Path x:Name="pathWatchOutline" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Stroke="{StaticResource TextSecondary}"
                                      Data="M1.6 12S5.3 5.4 12 5.4 22.4 12 22.4 12 18.7 18.6 12 18.6 1.6 12 1.6 12Z"/>
                                <Ellipse x:Name="ellipseWatchPupil" Canvas.Left="8.6" Canvas.Top="8.6" Width="6.8" Height="6.8"
                                         Fill="{StaticResource TextSecondary}"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <Button x:Name="btSettings" Style="{StaticResource CaptionIconButton}" Margin="1 0 8 0"
                            Click="btSettings_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                            ToolTip="Settings">
                        <Viewbox Width="17" Height="17">
                            <Canvas Width="24" Height="24">
                                <!-- A gear: six teeth is enough to read as one at this size. -->
                                <Path Stroke="{StaticResource TextSecondary}" StrokeThickness="1.9"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M12 15.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4Z"/>
                                <Path Stroke="{StaticResource TextSecondary}" StrokeThickness="1.9"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1.03 1.56V21a2 2 0 1 1-4 0v-.07A1.7 1.7 0 0 0 8.9 19.3a1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-1.56-1.03H3a2 2 0 1 1 0-4h.07A1.7 1.7 0 0 0 4.6 8.9a1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1.03-1.56V3a2 2 0 1 1 4 0v.07A1.7 1.7 0 0 0 15.1 4.6a1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.4 9v.03a1.7 1.7 0 0 0 1.56 1.03H21a2 2 0 1 1 0 4h-.07a1.7 1.7 0 0 0-1.53 1.03Z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <shell:UC_TransportStatus VerticalAlignment="Center" Margin="0 0 10 0"/>
                </StackPanel>

                <!--
                    A StackPanel rather than a UniformGrid: minimise is hidden while watch mode is armed,
                    and a uniform grid of three fixed cells would have left a hole on the right where the
                    close button should be.
                -->
                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <Button x:Name="btMinimize" Style="{StaticResource WindowButton}" Click="btMinimize_Click"
                            Width="46" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Viewbox>
                            <Canvas Height="100" Width="100">
                                <Line X1="37" Y1="49.5" X2="63" Y2="49.5" StrokeThickness="1.99"
                                      StrokeEndLineCap="Round" Stroke="White" RenderOptions.EdgeMode="Aliased"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="btMaximizer" Style="{StaticResource WindowButton}" Click="btMaximizer_Click"
                            Width="46" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Viewbox>
                            <Canvas Height="100" Width="100">
                                <Rectangle Canvas.Left="38" Canvas.Top="38" Width="24" Height="24"
                                           StrokeThickness="1.99" Stroke="White" RenderOptions.EdgeMode="Aliased"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="btClose" Style="{StaticResource WindowButton}" Click="btClose_Click"
                            Width="46" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Viewbox>
                            <Canvas Height="100" Width="100">
                                <Line X1="39" Y1="39" X2="61" Y2="61" StrokeThickness="1.99"
                                      StrokeEndLineCap="Round" Stroke="White" RenderOptions.EdgeMode="Aliased"/>
                                <Line X1="61" Y1="39" X2="39" Y2="61" StrokeThickness="1.99"
                                      StrokeEndLineCap="Round" Stroke="White" RenderOptions.EdgeMode="Aliased"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <!--
                The canvas is the application, so it takes the whole area and everything else floats
                over it. Panels in columns would have carved the board into the smallest region on
                screen — the one thing here that genuinely wants the space.
            -->
            <Grid Grid.Row="1">
                <board:UC_Board x:Name="ucBoard"/>

                <runs:UC_RunList HorizontalAlignment="Left" VerticalAlignment="Top" Width="290" MaxHeight="300"/>

                <detail:UC_ValueRail x:Name="ucValues" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                     Width="290" MaxHeight="360"/>

                <!-- The width here is only what the designer shows; the remembered one is applied at
                     startup, and the reader can drag the panel's left edge to change it. -->
                <detail:UC_StepDetail x:Name="ucStep" HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                      Width="390" Margin="0 0 0 44"/>

                <!-- Centred and on top: the summary is a question you ask about the whole run, so
                     it takes the foreground while it is open and gets out of the way when it is not. -->
                <detail:UC_RunSummary x:Name="ucSummary" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      MaxHeight="620" Visibility="Collapsed" Panel.ZIndex="2"/>

                <!-- Same treatment as the summary: a question about one thing, answered in the
                     foreground, out of the way once answered. -->
                <detail:UC_ValueInspector x:Name="ucValueInspector" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          MaxHeight="720" Visibility="Collapsed" Panel.ZIndex="2"/>

                <!-- Along the bottom of the canvas, the way a drawing tool puts its instruments. Above the
                     board it draws on, below the pages that cover the board entirely. -->
                <annotate:UC_AnnotationBar x:Name="ucAnnotate" Panel.ZIndex="2" Visibility="Collapsed"/>

                <!-- Tucked into the corner: it speaks for runs that are not on screen, so it should
                     be reachable without ever being in the way. -->
                <feed:UC_Feed HorizontalAlignment="Right" VerticalAlignment="Bottom"/>

                <!-- Where the window opens. Which run to look at is the question you have before you
                     have any question about a run, so it is answered first and covers everything. -->
                <settings:UC_Settings x:Name="ucSettings" Panel.ZIndex="4" Visibility="Collapsed"/>

                <home:UC_Home x:Name="ucHome" Panel.ZIndex="3"/>

                <!-- Above the runs page, because sharing is asked for from it and the answer belongs in front
                     of the question. Below settings, which is above everything. -->
                <share:UC_Export x:Name="ucExport" Panel.ZIndex="4" Visibility="Collapsed"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
