<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.20348.0</TargetFramework>
		<UseWPF>true</UseWPF>
		<SupportedOSPlatformVersion>10.0.20348.0</SupportedOSPlatformVersion>
		<ApplicationIcon>Icon.ico</ApplicationIcon>
		<RootNamespace>TestFramework.DebugUI</RootNamespace>

		<!-- Declares per-monitor DPI awareness. See app.manifest for why. -->
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
	  <Content Include="Icon.ico" />
	</ItemGroup>

	<ItemGroup>
		<!--
			Axiom.Wpf's Bind* extensions set a control's property straight from the subscription and marshal
			nothing. They are safe only because Axiom.State delivers every Bind on the context MainWindow
			builds the store with, the UI thread's; see the note on the State project's reference.
		-->
		<PackageReference Include="Axiom.State" Version="0.5.0" />
		<PackageReference Include="Axiom.Wpf" Version="0.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TestFramework.DebugUI.Docking\TestFramework.DebugUI.Docking.csproj" />
		<ProjectReference Include="..\TestFramework.DebugUI.Layout\TestFramework.DebugUI.Layout.csproj" />
		<ProjectReference Include="..\TestFramework.DebugUI.State\TestFramework.DebugUI.State.csproj" />
	</ItemGroup>

</Project>
