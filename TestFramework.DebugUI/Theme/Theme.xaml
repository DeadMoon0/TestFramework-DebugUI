<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The palette. The window is translucent over an acrylic backdrop, so surfaces are layered by
        opacity rather than by hue: each panel is a slightly lighter wash of the same black, which is
        what keeps the depth readable without any of it competing with the run itself.
    -->
    <SolidColorBrush x:Key="SurfaceSunken" Color="#FF171717"/>
    <SolidColorBrush x:Key="SurfacePanel" Color="#32000000"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="#FF232323"/>
    <SolidColorBrush x:Key="SurfaceRaisedHover" Color="#FF2C2C2C"/>
    <SolidColorBrush x:Key="SurfaceCard" Color="#FF323232"/>
    <SolidColorBrush x:Key="SurfaceDivider" Color="#FF151515"/>

    <!--
        Overlays are opaque. The window is translucent over an acrylic backdrop, which is right for
        the window; a panel floating above dense content is not the same thing, and a wash of the
        page behind it makes small text genuinely hard to read.
    -->
    <SolidColorBrush x:Key="SurfaceOverlay" Color="#FF1E1E1E"/>

    <!-- Dimming behind an overlay, so it reads as the thing that has focus. -->
    <SolidColorBrush x:Key="Scrim" Color="#A6000000"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#FFEDEDED"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#FF9A9A9A"/>
    <SolidColorBrush x:Key="TextFaint" Color="#FF6A6A6A"/>

    <!--
        Lifecycle colours, shared by the board, the run list and the feed. One source for them means
        a step reading "running" on the canvas cannot read "complete" in the picker.
    -->
    <SolidColorBrush x:Key="StateNotRun" Color="#FF5A5A5A"/>
    <SolidColorBrush x:Key="StateRunning" Color="#FF4680FC"/>
    <SolidColorBrush x:Key="StateComplete" Color="#FF62C98F"/>
    <SolidColorBrush x:Key="StateError" Color="#FFFC4646"/>
    <SolidColorBrush x:Key="StateTimeout" Color="#FFFCAF62"/>
    <SolidColorBrush x:Key="StateSkipped" Color="#FF7A7A7A"/>
    <SolidColorBrush x:Key="StatePaused" Color="#FFC46AC4"/>

    <SolidColorBrush x:Key="AccentSelection" Color="#FF4680FC"/>

    <!--
        Diff colours. The same red and green as the lifecycle states, split into a wash behind the line
        and a lighter ink on top of it: StateError and StateComplete are sized to be read as a dot or a
        stroke, and at text weight over a dark surface they are harsh and, in the red's case, hard to
        read for long. The backgrounds are deliberately low alpha so a page of changes still reads as
        text with bands behind it rather than as two blocks of colour.
    -->
    <SolidColorBrush x:Key="DiffAddedSurface" Color="#2662C98F"/>
    <SolidColorBrush x:Key="DiffAddedText" Color="#FF9FE3BB"/>
    <SolidColorBrush x:Key="DiffRemovedSurface" Color="#26FC4646"/>
    <SolidColorBrush x:Key="DiffRemovedText" Color="#FFF4A0A0"/>

    <!-- Unchanged lines are there for orientation, so they sit back from the changes. -->
    <SolidColorBrush x:Key="DiffContextText" Color="#FF8A8A8A"/>

    <!--
        Pipes and connectors are coloured by what flows through them, not by where they go. A
        variable is a value and an artifact is a thing with a lifecycle: they behave differently, and
        telling them apart at a glance is most of what makes a busy board readable.
    -->
    <SolidColorBrush x:Key="FlowVariable" Color="#FF2AFC4D"/>
    <SolidColorBrush x:Key="FlowVariableSurface" Color="#FF3F7C7F"/>
    <SolidColorBrush x:Key="FlowArtifact" Color="#FFFCC22A"/>
    <SolidColorBrush x:Key="FlowArtifactSurface" Color="#FF4D7F3F"/>

    <!-- The soft edge either side of a pipe's core, which is what gives it depth. -->
    <SolidColorBrush x:Key="PipeShadow" Color="#32000000"/>

    <!-- The recessed strips a step's connectors sit in, top and bottom. -->
    <SolidColorBrush x:Key="ConnectorStrip" Color="#FF242424"/>

    <!-- Panels -->

    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="{StaticResource SurfacePanel}"/>
        <Setter Property="Margin" Value="5"/>
    </Style>

    <!--
        A panel that floats over the canvas rather than taking space from it. Opaque enough to read
        against a board of bright pipes, and inset from the edge so the canvas is visibly continuous
        underneath — the board is the application, and the panels are things laid on top of it.
    -->
    <Style x:Key="PanelOverlay" TargetType="Border">
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="{StaticResource SurfaceOverlay}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#14FFFFFF"/>
        <Setter Property="Margin" Value="10"/>
    </Style>

    <Style x:Key="PanelHeading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="10 8 10 6"/>
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="MutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="CodeText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!--
        The one button shape the application uses, at two weights. Flat, quiet until hovered, and
        rounded to the same 4 as everything else.
    -->
    <Style x:Key="FlatButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        <Setter Property="Background" Value="{StaticResource SurfaceRaised}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="10 5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bRoot" CornerRadius="4" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bRoot" Property="Background" Value="{StaticResource SurfaceRaisedHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                            <Setter TargetName="bRoot" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Geometries rather than a font: the app ships no icon font, and a Path is themeable by the same
        brushes as everything else. Kept here so the same glyph cannot drift between two panels.
    -->
    <Geometry x:Key="IconClose">M 4,4 L 14,14 M 14,4 L 4,14</Geometry>
    <Geometry x:Key="IconFolder">M 2,4.5 L 7,4.5 L 8.6,6.5 L 16,6.5 L 16,14 L 2,14 Z</Geometry>
    <Geometry x:Key="IconTrash">M 3,5.5 L 15,5.5 M 7,5.5 L 7,3.5 L 11,3.5 L 11,5.5 M 4.5,5.5 L 5.4,15 L 12.6,15 L 13.5,5.5</Geometry>
    <Geometry x:Key="IconRefresh">M 15,9 A 6,6 0 1 1 12.8,4.4 M 15,3.2 L 15,4.6 L 13.6,4.6</Geometry>

    <!--
        The title bar's own set, drawn in the same 18-unit box as the ones above so a row of them sits on
        one baseline.

        Continue is a bar and a triangle rather than a plain triangle, because a plain triangle is what
        every application uses for "start" and this one resumes something already running. Re-run turns
        the other way from Refresh above: one repeats a test, the other re-reads the disk, and they sit on
        different surfaces, but they should not be the same picture.
    -->
    <Geometry x:Key="IconHome">M 2.6,8.6 L 9,3 L 15.4,8.6 M 4.6,7.4 L 4.6,15 L 13.4,15 L 13.4,7.4</Geometry>
    <Geometry x:Key="IconContinue">M 4.4,4.2 L 4.4,13.8 M 8.2,4.6 L 14.6,9 L 8.2,13.4 Z</Geometry>
    <Geometry x:Key="IconStop">M 5.2,5.2 L 12.8,5.2 L 12.8,12.8 L 5.2,12.8 Z</Geometry>

    <!-- Step forward: an arc hopping over the step it is leaving, which is the shape every debugger uses. -->
    <Geometry x:Key="IconStepOver">M 3.6,8.6 A 5.4,5.4 0 0 1 14.4,8.6 M 14.4,8.6 L 12.1,7.3 M 14.4,8.6 L 12.2,10.4 M 9,11.7 A 1.7,1.7 0 1 1 9,15.1 A 1.7,1.7 0 1 1 9,11.7 Z</Geometry>
    <Geometry x:Key="IconRerun">M 3,9 A 6,6 0 1 0 5.2,4.4 M 3,3.2 L 3,4.6 L 4.4,4.6</Geometry>
    <Geometry x:Key="IconAlert">M 9,3.4 L 15.8,14.4 L 2.2,14.4 Z M 9,7.2 L 9,10.6 M 9,12.3 L 9,12.6</Geometry>
    <Geometry x:Key="IconSummary">M 3.4,4.4 L 14.6,4.4 M 3.4,7.8 L 14.6,7.8 M 3.4,11.2 L 10.6,11.2 M 3.4,14.6 L 8.2,14.6</Geometry>
    <Geometry x:Key="IconFit">M 3,7 L 3,3 L 7,3 M 11,3 L 15,3 L 15,7 M 15,11 L 15,15 L 11,15 M 7,15 L 3,15 L 3,11</Geometry>

    <!-- Copy, and the tick that confirms it. Nothing else in the window says "that worked". -->
    <Geometry x:Key="IconCopy">M 6.6,6.6 L 6.6,3.4 L 14.6,3.4 L 14.6,11.4 L 11.4,11.4 M 3.4,6.6 L 11.4,6.6 L 11.4,14.6 L 3.4,14.6 Z</Geometry>
    <Geometry x:Key="IconTick">M 3.8,9.4 L 7.4,13 L 14.2,5.6</Geometry>

    <!--
        An icon-only button. Square, so a row of them lines up, and the glyph is stroked rather than
        filled so one geometry serves every size.
    -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="22"/>
    </Style>

    <!--
        The same button for the title bar, with no resting background. A row of filled pills in the chrome
        reads as a toolbar bolted onto the caption; unfilled, the glyphs sit in the bar and only the one
        under the pointer lights up.
    -->
    <Style x:Key="CaptionIconButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="Margin" Value="1 0"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
        <Setter Property="Background" Value="{StaticResource AccentSelection}"/>
    </Style>

    <!--
        The caption buttons. One style rather than the same forty lines repeated per button: the
        glyph is the content, and the fade on hover is identical for all three.
    -->
    <Style x:Key="WindowButton" TargetType="Button">
        <Setter Property="Background" Value="#001B1B1B"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Panel.ZIndex" Value="10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                            From="#001B1B1B" To="#BF1B1B1B" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                            From="#BF1B1B1B" To="#001B1B1B" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Scroll bars: slim, unobtrusive, no arrow buttons. Carried over unchanged. -->

    <Style x:Key="ScrollBarPageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="Visibility" Value="Hidden"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="IsTabStop" Value="false"/>
        <Setter Property="Focusable" Value="false"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ScrollBarThumb" TargetType="{x:Type Thumb}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Setter Property="IsTabStop" Value="false"/>
        <Setter Property="Focusable" Value="false"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderThickness="0"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="VerticalScrollBar" TargetType="{x:Type ScrollBar}">
        <Grid Width="10">
            <Grid.RowDefinitions>
                <RowDefinition MaxHeight="0"/>
                <RowDefinition Height="0.00001*"/>
                <RowDefinition MaxHeight="0"/>
            </Grid.RowDefinitions>
            <Border Grid.RowSpan="3" CornerRadius="2" Background="Transparent"/>
            <Track Name="PART_Track" Grid.Row="1" IsDirectionReversed="true">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBarThumb}" Margin="1,0,1,0" Background="#FF686868"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="HorizontalScrollBar" TargetType="{x:Type ScrollBar}">
        <Grid Height="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition MaxWidth="0"/>
                <ColumnDefinition Width="0.00001*"/>
                <ColumnDefinition MaxWidth="0"/>
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="3" CornerRadius="2" Background="Transparent"/>
            <Track Name="PART_Track" Grid.Column="1" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageLeftCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollBarThumb}" Margin="0,1,0,1" Background="#FF686868"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageButton}" Command="ScrollBar.PageRightCommand"/>
                </Track.IncreaseRepeatButton>
            </Track>
        </Grid>
    </ControlTemplate>

    <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="true"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="Height" Value="10"/>
                <Setter Property="Template" Value="{StaticResource HorizontalScrollBar}"/>
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="10"/>
                <Setter Property="Height" Value="Auto"/>
                <Setter Property="Template" Value="{StaticResource VerticalScrollBar}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GSCol" TargetType="GridSplitter">
        <Setter Property="ResizeDirection" Value="Columns"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Width" Value="3"/>
        <Setter Property="Margin" Value="0 10 0 10"/>
        <Setter Property="Background" Value="{StaticResource SurfaceDivider}"/>
    </Style>

    <Style x:Key="GSRow" TargetType="GridSplitter">
        <Setter Property="ResizeDirection" Value="Rows"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Height" Value="3"/>
        <Setter Property="Margin" Value="10 0 10 0"/>
        <Setter Property="Background" Value="{StaticResource SurfaceDivider}"/>
    </Style>

</ResourceDictionary>
