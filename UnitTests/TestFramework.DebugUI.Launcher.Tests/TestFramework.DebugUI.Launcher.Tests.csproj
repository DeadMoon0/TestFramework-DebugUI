<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Follows the launcher's own target framework; see the comment on it for why it is plain. -->
		<TargetFramework>net8.0-windows</TargetFramework>
		<IsPackable>false</IsPackable>
		<UseWPF>true</UseWPF>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
		<PackageReference Include="xunit" Version="2.5.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />

		<!--
			Referenced by the tests and deliberately not by the launcher, which stays a dependency-free
			shell. It is here so the folder the launcher creates can be compared with the folder Core
			looks for: that agreement spans two packages and two processes, and this is the only place
			both sides are loadable at once.
		-->
		<PackageReference Include="TestFramework.Core" Version="0.7.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\TestFramework.DebugUI.Launcher\TestFramework.DebugUI.Launcher.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

</Project>
