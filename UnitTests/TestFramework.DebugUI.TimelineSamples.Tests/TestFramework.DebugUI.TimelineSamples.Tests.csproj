<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TestFramework.Core" Version="0.5.0" />
    <PackageReference Include="TestFramework.Simple" Version="0.3.0" />
    <PackageReference Include="TestFramework.LocalIO" Version="0.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Real pages of the family's own sample shop, photographed by the browser pack. The samples
      publish these as widgets, so the window has something recognisable to draw rather than a
      coloured square standing in for a page.
    -->
    <Content Include="Pages\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
